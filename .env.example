# Server Configuration
PORT=8000
ENVIRONMENT=development
DEMO_MODE=true

# Database (MongoDB Atlas or local, fallback to built-in JSON DB if omitted)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/recoverai?retryWrites=true&w=majority

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret

# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key
